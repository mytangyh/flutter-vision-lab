# Required OpenAI-compatible endpoint and model.
# HTTPS is mandatory unless ALLOW_HTTP_UPSTREAM=true is explicitly set for local use.
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
VLM_DISABLE_THINKING=true
VLM_IMAGE_DETAIL=low
VLM_MAX_TOKENS=160

# Required shared token for the packaged research client; use 32+ random characters.
CLIENT_TOKEN=
ALLOW_HTTP_UPSTREAM=false
HTTP_TRUST_ENV=false

CONNECT_TIMEOUT_SECONDS=5
REQUEST_TIMEOUT_SECONDS=20
UPSTREAM_MAX_ATTEMPTS=2
UPSTREAM_RETRY_BASE_SECONDS=0.5
UPSTREAM_MAX_RESPONSE_BYTES=1048576

MAX_IMAGE_BYTES=2097152
MAX_IMAGE_DIMENSION=4096
MAX_CONCURRENT_REQUESTS=4
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
